<mjml>
  <mj-body>
    <mj-section>
      <mj-column border-left="none" border-radius="5px" inner-border-radius="5px" background-color="#ffffff">
        <mj-text>Without gutter</mj-text>
      </mj-column>
      <mj-column padding="4px" border-left="1px solid #000000" border-top="2px solid #ff0000" border-radius="5px" inner-border-radius="3px" background-color="#eeeeee" inner-background-color="#ffffff">
        <mj-text>With gutter</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

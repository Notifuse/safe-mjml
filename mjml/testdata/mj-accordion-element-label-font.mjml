<mjml>
  <mj-head>
    <mj-attributes>
      <mj-accordion-element font-family="Roboto, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-accordion>
          <mj-accordion-element>
            <mj-accordion-title font-family="Arial">Label in Roboto</mj-accordion-title>
            <mj-accordion-text font-family="Arial">The label font must be imported</mj-accordion-text>
          </mj-accordion-element>
        </mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-style inline="INLINE">.upper { color: #ff0000; }</mj-style>
    <mj-style inline=" inline">.spaced { color: #00ff00; }</mj-style>
    <mj-style inline="Inline">.capital { color: #0000ff; }</mj-style>
    <mj-style inline="inline">.exact { color: #123456; }</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text css-class="upper">Upper</mj-text>
        <mj-text css-class="spaced">Spaced</mj-text>
        <mj-text css-class="capital">Capital</mj-text>
        <mj-text css-class="exact">Exact</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="ringed" border="1px dotted #445566" />
      <mj-social-element icon-size="21px" />
    </mj-attributes>
  </mj-head>
  <mj-body width="601px">
    <mj-section>
      <mj-column>
        <mj-social border="2px solid #112233" border-radius="7px 3px">
          <mj-social-element name="facebook" href="https://example.com/f">Facebook</mj-social-element>
          <mj-social-element name="x" href="https://example.com/x" border="3px dashed red">X</mj-social-element>
          <mj-social-element name="github" href="https://example.com/g" border="">GitHub</mj-social-element>
          <mj-social-element name="linkedin" href="https://example.com/l" mj-class="ringed">LinkedIn</mj-social-element>
        </mj-social>
        <mj-social mode="vertical">
          <mj-social-element name="facebook" href="https://example.com/f">Default border</mj-social-element>
          <mj-social-element name="x" border-radius="50%">Round</mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-attributes>
      <mj-image src="https://example.com/fallback.png" />
      <mj-class name="nosrc" src="" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-image src="" alt="An empty src hides mj-attributes" />
        <mj-image alt="No src: mj-attributes gives one" />
        <mj-image mj-class="nosrc" alt="An empty src from mj-class" />
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-image alt="Still the fallback" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-body width="-601px" background-color="#f4f4f4">
    <mj-wrapper padding="7px 13px" border="1px solid #333333">
      <mj-section padding="9px 11px">
        <mj-column width="37.5%"><mj-text>a</mj-text><mj-button href="https://example.com" width="73px">b</mj-button></mj-column>
        <mj-column width="173px" padding="3px"><mj-image src="https://example.com/a.png" width="91px" /><mj-image src="https://example.com/n.png" width="-41px" /><mj-divider /></mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section full-width="full-width" gutter="7px">
      <mj-group>
        <mj-column><mj-text>c</mj-text></mj-column>
        <mj-column><mj-divider width="47%" /></mj-column>
      </mj-group>
    </mj-section>
    <mj-hero background-url="https://example.com/h.png" background-width="601px" background-height="301px" mode="fluid-height" padding="17px">
      <mj-text>hero</mj-text>
      <mj-image src="https://example.com/i.png" />
    </mj-hero>
    <mj-section>
      <mj-column>
        <mj-carousel><mj-carousel-image src="https://example.com/1.png" /><mj-carousel-image src="https://example.com/2.png" /></mj-carousel>
        <mj-navbar><mj-navbar-link href="https://example.com">l</mj-navbar-link></mj-navbar>
        <mj-social><mj-social-element name="facebook" href="https://example.com">f</mj-social-element></mj-social>
        <mj-table><tr><td>t</td></tr></mj-table>
        <mj-spacer height="13px" />
        <mj-accordion><mj-accordion-element><mj-accordion-title>q</mj-accordion-title><mj-accordion-text>r</mj-accordion-text></mj-accordion-element></mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-attributes>
      <mj-table padding-left="40px" />
      <mj-class name="spaced" padding-top="30px" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-table>
          <tr><td>Cell</td></tr>
        </mj-table>
        <mj-social mj-class="spaced">
          <mj-social-element name="facebook" href="https://www.facebook.com">Facebook</mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

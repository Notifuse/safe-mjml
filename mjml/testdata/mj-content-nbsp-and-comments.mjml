<mjml>
  <mj-body width="601px">
    <mj-section padding="7px 13px">
      <mj-column>
        <mj-text>Price:&nbsp;12&nbsp;€, <b>bold</b>&nbsp;<i>italic</i> and a&nbsp;&nbsp;double space</mj-text>

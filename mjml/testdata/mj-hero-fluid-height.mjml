<mjml>
  <mj-body>
    <mj-hero mode="fluid-height" background-url="https://example.com/bg.png" background-width="600px" background-height="300px" padding="20px 10px" height="400px">
      <mj-text>The fluid-height mode keeps the image's ratio, and ignores the height</mj-text>
    </mj-hero>
    <mj-hero mode="fluid-height" background-width="400px" background-height="333px" background-color="#123456" vertical-align="middle">
      <mj-button href="https://example.com">A ratio that rounds</mj-button>
    </mj-hero>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-style inline="inline">
      .lead { color: #123456; }
      /* juice start ignore */
      .note { color: #aa0000; }
      /* juice end ignore */
      /* juice ignore next */
      .skip { font-style: italic; }
      .card {
        /* juice ignore next */
        border: 1px solid #cccccc;
        padding: 3px;
      }
      .empty { }
    </mj-style>
    <mj-style inline="inline">
      /* juice ignore */
      .late { font-weight: bold; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="lead">Lead</p>
          <p class="note">Note</p>
          <p class="skip">Skipped</p>
          <p class="card" style="/* juice ignore next */ margin: 7px; line-height: 21px">Card</p>
          <p class="empty" style="color:#00aa00">Unchanged</p>
          <p class="late">Late</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

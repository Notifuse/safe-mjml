<mjml>
  <mj-head>
    <mj-html-attributes>
      <mj-selector path=".a"><mj-html-attribute name="data-x">1</mj-html-attribute></mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-text>Text directly in a section</mj-text>
      <mj-column>
        <mj-foo>Unknown tag</mj-foo>
        <mj-text foo="bar">Invalid attribute</mj-text>
        <mj-column><mj-text>Column in a column</mj-text></mj-column>
      </mj-column>
    </mj-section>
    <mj-spacer height="10px" />
  </mj-body>
</mjml>

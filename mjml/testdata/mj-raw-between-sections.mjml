<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>Before the raw block</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw><p class="raw">Raw HTML between two sections</p></mj-raw>
    <mj-section background-url="https://example.com/bg.png">
      <mj-column>
        <mj-text>Section with a background</mj-text>
      </mj-column>
    </mj-section>
    <mj-raw><p class="raw">Raw HTML after a background section</p></mj-raw>
    <mj-section>
      <mj-column>
        <mj-text>After the raw blocks</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

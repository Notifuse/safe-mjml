<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>Section before the wrapper</mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper full-width="full-width" background-color="#eeeeee">
      <mj-section>
        <mj-column>
          <mj-text>Section inside a full-width wrapper</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>

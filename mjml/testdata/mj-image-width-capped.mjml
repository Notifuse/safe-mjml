<mjml>
  <mj-head>
    <mj-attributes>
      <mj-image width="100px" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column width="300px">
        <mj-image width="500px" src="https://example.com/a.png" />
        <mj-image src="https://example.com/b.png" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

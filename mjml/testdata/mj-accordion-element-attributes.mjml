<mjml>
  <mj-head>
    <mj-attributes>
      <mj-accordion-element icon-height="40px" />
      <mj-class name="wide-icon" icon-width="50px" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-accordion>
          <mj-accordion-element mj-class="wide-icon">
            <mj-accordion-title>Question</mj-accordion-title>
            <mj-accordion-text>Answer</mj-accordion-text>
          </mj-accordion-element>
        </mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

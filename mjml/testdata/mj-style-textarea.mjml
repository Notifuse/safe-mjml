<mjml>
  <mj-head>
    <mj-style inline="inline">
      p { margin: 0; }
      .reply { color: #0b57d0; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <textarea rows="3"><p class="reply">Not a paragraph</p></textarea>
          <p class="reply">A paragraph</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

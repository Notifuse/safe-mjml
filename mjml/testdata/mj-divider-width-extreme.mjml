<mjml>
  <mj-body width="601px">
    <mj-section>
      <mj-column>
        <mj-text>widths that JavaScript writes with an exponent</mj-text>
        <mj-divider width="1000000000000000000000%" padding="7px 13px" />
        <mj-divider width="999999999999999999999%" padding="11px 9px" />
        <mj-divider width="1250000000000000000000%" />
        <mj-divider width="%" padding="3px 17px" />
        <mj-divider width="37.5%" padding="5px 21px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

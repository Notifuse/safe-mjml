<mjml>
  <mj-head>
    <mj-attributes>
      <mj-accordion-title padding="0px" font-size="50px" />
      <mj-accordion-text padding="0px" font-size="40px" />
      <mj-all font-size="30px" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-accordion>
          <mj-accordion-element><mj-accordion-text>Text without a title</mj-accordion-text></mj-accordion-element>
          <mj-accordion-element><mj-accordion-title>Title without a text</mj-accordion-title></mj-accordion-element>
        </mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

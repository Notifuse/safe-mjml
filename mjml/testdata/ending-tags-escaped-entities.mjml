        <mj-social><mj-social-element name="facebook" href="https://example.com/f">F &lt;f&gt;</mj-social-element></mj-social>
      </mj-column>
    </mj-section>
    <mj-raw><p>Raw &lt;r&gt;</p></mj-raw>
  </mj-body>
</mjml>

<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-accordion>
          <mj-raw><tr><td class="raw">Raw before the elements</td></tr></mj-raw>
          <mj-accordion-element>
            <mj-accordion-title>Title</mj-accordion-title>
            <mj-raw><span class="raw">Raw inside the element</span></mj-raw>
            <mj-accordion-text>Text</mj-accordion-text>
          </mj-accordion-element>
        </mj-accordion>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

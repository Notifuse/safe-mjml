<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="m" padding="7px 13px 9px 31px" />
    </mj-attributes>
  </mj-head>
  <mj-body width="333px">
        <mj-section>
            <mj-column>
              <mj-image src="https://example.com/image.png" />
              <mj-text mj-class="m">Text in the measured column</mj-text>
              <mj-button href="https://example.com">Button</mj-button>
              <mj-divider />
              <mj-table><tr><td>Cell</td><td>Cell</td></tr></mj-table>
              <mj-social><mj-social-element name="facebook" href="https://example.com">Facebook</mj-social-element></mj-social>
              <mj-spacer />
            </mj-column>
            <mj-column>
              <mj-text>Second column</mj-text>
            </mj-column>
        </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-font name="Brand" href="https://fonts.example.com/css?family=Brand&amp;display=swap" />
    <mj-attributes>
      <mj-class name="quoted" font-family="&quot;Open Sans&quot;, Arial" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-family="&quot;Helvetica Neue&quot;, Arial, sans-serif" font-size="16px" color="#333333">Encoded quotes in a style</mj-text>
        <mj-text mj-class="quoted">Encoded quotes through mj-class</mj-text>
        <mj-text font-family="Brand, Arial">A font whose href has an escaped ampersand</mj-text>
        <mj-image src="https://example.com/a.png?w=1&amp;h=2" alt="A &amp;copy; &amp;lt; B &quot;C&quot;" title="&lt;b&gt;" />
        <mj-divider border-color="#000&quot;&gt;&lt;script&gt;alert(1)&lt;/script&gt;" />
        <mj-carousel>
          <mj-carousel-image src="https://example.com/1.png" alt="a &quot;1&quot;" href="https://example.com/?a=1&amp;b=2" />
          <mj-carousel-image src="https://example.com/2.png" />
        </mj-carousel>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

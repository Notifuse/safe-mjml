<mjml>
  <mj-head>
    <mj-style inline="inline">
      .a { color: red; }
      .q { font-family: "Open Sans", Arial !important; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text><span class='q' style='color:blue'>A single-quoted style takes a rule with quotes</span></mj-text>
        <mj-text><a class=a href=https://example.com/path>Class before an unquoted href</a></mj-text>
        <mj-text><a href=https://example.com/path class=a>Class after an unquoted href</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

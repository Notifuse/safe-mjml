<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p>{% if order.gift %}<b>A gift</b> for {{ order.recipient }}</p><p>{% endif %}Thank you</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-button href="{% if contact.vip %}https://example.com/vip{% else %}https://example.com{% endif %}">Open</mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="liq">{{ company | replace: "&", "and" }} &amp; {{ partner }}</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
    <mj-style inline="inline">.liq { font-weight: bold; } a { color: #0b57d0; } span, li { line-height: 20px; } img { border-radius: 4px; }</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-navbar>
          <mj-navbar-link href="{{ links.home }}">Home</mj-navbar-link>
          <mj-navbar-link href="/account?id={{ contact.id }}">{{ "Account" | t }}</mj-navbar-link>
        </mj-navbar>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
    <mj-style inline="inline">.liq { font-weight: bold; } a { color: #0b57d0; } span, li { line-height: 20px; } img { border-radius: 4px; }</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text color="{{ brand.color }}" padding="{{ layout.padding }}" font-size="{{ layout.font_size }}">
          <p>Hello</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

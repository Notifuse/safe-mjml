<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
    <mj-style inline="inline">.liq { font-weight: bold; } a { color: #0b57d0; } span, li { line-height: 20px; } img { border-radius: 4px; }</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="liq">Hello {{ contact.first_name | default: "there" }}, your order {{ order.number }} ships on {{ order.date | date: "%B %-d" }}.</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

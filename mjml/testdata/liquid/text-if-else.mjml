<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          {% if contact.vip %}<p class="liq"><b>Thank you for being a VIP.</b></p>{% else %}<p class="liq">Thank you.</p>{% endif %}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

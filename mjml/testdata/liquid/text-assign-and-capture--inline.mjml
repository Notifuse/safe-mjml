<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
    <mj-style inline="inline">.liq { font-weight: bold; } a { color: #0b57d0; } span, li { line-height: 20px; } img { border-radius: 4px; }</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          {% assign greeting = "Hello" %}{% capture name %}{{ contact.first_name | capitalize }}{% endcapture %}<p class="liq">{{ greeting }} {{ name }}</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

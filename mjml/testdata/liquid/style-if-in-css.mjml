<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
    <mj-style>{% if dark %}.liq { color: #ffffff; }{% endif %}</mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="liq">Thank you for your order.</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

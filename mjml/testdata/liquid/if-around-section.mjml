<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="liq">Thank you for your order.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    {% if order.gift %}
    <mj-section>
      <mj-column>
        <mj-text>
          <p>A gift message</p>
        </mj-text>
      </mj-column>
    </mj-section>
    {% endif %}
  </mj-body>
</mjml>

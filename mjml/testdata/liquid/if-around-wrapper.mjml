<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    {% if banner %}
    <mj-wrapper background-color="#f0f0f0">
    <mj-section>
      <mj-column>
        <mj-text>
          <p class="liq">Thank you for your order.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
    {% endif %}
  </mj-body>
</mjml>

<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      {% if contact.vip %}
      <mj-column>
        <mj-text>
          <p>VIP</p>
        </mj-text>
      </mj-column>
      {% endif %}
      <mj-column>
        <mj-text>
          <p>Everyone</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

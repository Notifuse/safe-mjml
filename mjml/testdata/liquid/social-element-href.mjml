<mjml>
  <mj-head>
    <mj-title>Order {{ order.number }}</mj-title>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-social>
          <mj-social-element name="facebook" href="{{ social.facebook }}">Facebook</mj-social-element>
          <mj-social-element name="x" href="https://x.com/{{ social.x_handle }}">{{ social.x_label }}</mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

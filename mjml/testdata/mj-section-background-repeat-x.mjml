<mjml>
  <mj-body>
    <mj-section background-url="https://example.com/bg.png" background-position="bottom right" background-position-x="20%" background-size="200px auto" background-repeat="repeat-x">
      <mj-column>
        <mj-text>Section with a repeat-x background</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-url="https://example.com/bg.png" background-position="33.5% 20px" background-repeat="repeat-y">
      <mj-column>
        <mj-text>Decimal and pixel positions</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
